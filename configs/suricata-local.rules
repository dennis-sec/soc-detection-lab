# Custom Suricata detection rules — SOC Detection Lab
# Author: Dennis
# Deployed on both the LAN and VULNHUB Suricata instances (pfSense / Suricata, IDS mode)
# SID range 1000001–1000006 (local rules space)
#
# Coverage: nmap scan variants (SYN/FIN/XMAS/NULL), ICMP ping sweep, SSH brute-force.
# $HOME_NET resolves per-interface to that interface's subnet, so these fire on
# traffic directed INTO the protected network (i.e. scans against lab hosts/targets).
# Verified live: SID 1000001 fired on the first nmap scan of the DC-1 target (Phase 10/11).

alert tcp any any -> $HOME_NET any (msg:"LOCAL Nmap SYN Scan Detected"; flags:S; threshold:type both,track by_src,count 20,seconds 5; classtype:attempted-recon; sid:1000001; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"LOCAL Nmap FIN Scan Detected"; flags:F; threshold:type both,track by_src,count 10,seconds 5; classtype:attempted-recon; sid:1000002; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"LOCAL Nmap XMAS Scan Detected"; flags:FPU; threshold:type both,track by_src,count 5,seconds 5; classtype:attempted-recon; sid:1000003; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"LOCAL Nmap NULL Scan Detected"; flags:0; threshold:type both,track by_src,count 5,seconds 5; classtype:attempted-recon; sid:1000004; rev:1;)
alert icmp any any -> $HOME_NET any (msg:"LOCAL ICMP Ping Sweep Detected"; threshold:type both,track by_src,count 5,seconds 5; classtype:network-scan; sid:1000005; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"LOCAL SSH Brute Force Attempt"; flow:established; content:"SSH-"; threshold:type both,track by_src,count 5,seconds 30; classtype:attempted-user; sid:1000006; rev:1;)
